# Copy to .env (git-ignored). Every value is optional; defaults work offline.
CONTROLBENCH_SEED=0
CONTROLBENCH_EPISODES=100
CONTROLBENCH_OUT=results
# Sandbox worker threads (default: number of CPUs) and binary location override
# CONTROLBENCH_WORKERS=4
# CONTROLBENCH_SANDBOX_BIN=build/cb_sandbox

# Optional Claude adapter - OFF by default. Needs `pip install anthropic`.
CONTROLBENCH_ENABLE_CLAUDE=0
# ANTHROPIC_API_KEY=
# CONTROLBENCH_CLAUDE_MODEL=claude-sonnet-5-5
